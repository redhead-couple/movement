{
  "name": "desktop-authoring-kit",
  "description": "Editable, no-installer Windows desktop distribution for local authoring and AI-assisted effect and transition development.",
  "platform": "windows",
  "architecture": "x64",
  "files": [
    "package.json",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "MEDIA_ATTRIBUTION.md",
    "SECURITY.md",
    "desktop/**/*",
    "shared/frontend/**/*",
    "assets/app.css",
    "img/bg_wanaka.webp",
    "examples/**/*",
    "!examples/**/backups/**/*",
    "!examples/**/*.save.lock",
    "!examples/**/.movement-media-trash/**/*",
    "effects/**/*",
    "transitions/**/*",
    "studio/**/*",
    "docs/OPERATING_MODES.md",
    "docs/DESKTOP_AUTHORING_KIT.md",
    "docs/EFFECTS_AND_TRANSITIONS.md",
    "docs/ENGINE_CATALOG.md",
    "docs/ENGINE_AUTHORING_GUIDE.md",
    "docs/EFFECT_AUTHORING_CONTRACT.md",
    "docs/TRANSITION_AUTHORING_CONTRACT.md",
    "docs/ANIMATION_PERFORMANCE_BUDGET.md",
    "docs/flow-schema.md",
    "tests/*.test.cjs",
    "!tests/php-layout.test.cjs",
    "!tests/distribution-config.test.cjs",
    "!tests/desktop-authoring-kit.test.cjs",
    "tools/start-electron.cjs",
    "tools/verify-media-provenance.cjs",
    "distribution/media-provenance.json",
    "distribution/desktop-authoring-kit.manifest.json"
  ],
  "requiredPaths": [
    "package.json",
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "shared/frontend/platform-adapter.js",
    "studio/editor/json-maker.html",
    "studio/editor/json-maker-logic.js",
    "studio/player/local-player.html",
    "studio/player/player-runtime.js",
    "studio/authoring/registry-editor.html",
    "studio/authoring/effect-prompt-builder.html",
    "studio/authoring/transition-prompt-template.js",
    "effects/registry.json",
    "transitions/registry.json",
    "docs/DESKTOP_AUTHORING_KIT.md",
    "docs/EFFECT_AUTHORING_CONTRACT.md",
    "docs/TRANSITION_AUTHORING_CONTRACT.md",
    "MEDIA_ATTRIBUTION.md",
    "distribution/media-provenance.json",
    "tools/verify-media-provenance.cjs",
    "distribution/desktop-authoring-kit.manifest.json"
  ],
  "forbiddenPaths": [
    "private-data",
    "server",
    "templates",
    "node_modules",
    "dist",
    "backups",
    ".save.lock",
    ".movement-media-trash"
  ],
  "forbiddenExtensions": [
    ".php"
  ]
}
